{
  "name": "mahi-ui-component-playground",
  "version": "1.0.0",
  "description": "Comprehensive, interactive platform for UI components, UI/UX design systems, theme customization, background generation, animation exploration, 3D experiences, code generation, and frontend resource discovery.",
  "main": "app.js",
  "bin": {
    "mahi-ui": "./bin/mahi-ui.js"
  },
  "scripts": {
    "cli": "node bin/mahi-ui.js",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint.js",
    "legacy:serve": "npx -y serve -l 3000",
    "test": "node scripts/validate-catalog.js && node scripts/test-ecosystem.js && node tests/unit/contrast-calculator.test.js && node tests/unit/registry-validation.test.js && node tests/unit/security-regression.test.js && node tests/accessibility/a11y-check.test.js && node tests/unit/quality-gates.test.js && node tests/e2e-simulation.js && tsc --noEmit",
    "test:catalog": "node scripts/validate-catalog.js",
    "test:unit": "node tests/unit/contrast-calculator.test.js",
    "test:a11y": "node tests/accessibility/a11y-check.test.js",
    "test:ecosystem": "node scripts/test-ecosystem.js",
    "test:e2e": "node tests/e2e-simulation.js",
    "test:browser": "playwright test",
    "audit:links": "node scripts/audit-links.js",
    "audit:links:all": "node scripts/audit-links.js --all",
    "clean-urls": "node scripts/clean-urls.js"
  },
  "keywords": [
    "ui-components",
    "design-system",
    "threejs",
    "webgl",
    "animations",
    "charts",
    "frontend-resources",
    "playground",
    "shadcn",
    "cult-ui"
  ],
  "author": "Mahi Developer Universe",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/jszip": "^3.4.0",
    "@types/node": "^26.6.5",
    "@types/jszip": "^3.4.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@types/three": "^0.186.0",
    "clsx": "^2.1.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.60.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  }
}
